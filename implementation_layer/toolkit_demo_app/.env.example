# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# Backend API
BACKEND_URL=http://localhost:8000

# Optional LMCLI command. If unset or unavailable, the clinical path uses the
# conservative local deterministic extractor.
CLINICAL_LMCLI_COMMAND=lmcli

# Local persistence targets
CLINICAL_SQLITE_PATH=./data/clinical.sqlite3
CLINICAL_VECTOR_BACKEND=sqlite-vec
