# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# Backend API
BACKEND_URL=http://localhost:8000

# Azure OpenAI
AZURE_API_KEY=your-azure-api-key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=latest

# Standard OpenAI alternative
OPENAI_API_KEY=your-openai-api-key

# Planned local persistence targets (not required by the current UI path)
CLINICAL_SQLITE_PATH=./data/clinical.sqlite3
CLINICAL_VECTOR_BACKEND=sqlite-vec

# Current external dependency still used by the active extraction pipeline:
# Azure OpenAI or OpenAI. Replace this next with LMCLI if you want zero third-party model calls.
